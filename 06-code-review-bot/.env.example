# PostgreSQL connection (Neon / Supabase free tier)
DATABASE_URL=postgresql://user:password@host/reviewbot

# Dashboard login password for seeded accounts (default: ChangeMe123!)
SEED_PASSWORD=ChangeMe123!

# GitHub App credentials (required for real webhook mode)
# Create a GitHub App at https://github.com/settings/apps/new
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=ghp_your_github_token_here

# OpenAI API key (required for AI review mode)
# Leave blank or set to "mock" to use deterministic mock reviews
OPENAI_API_KEY=sk-...

# Set to "1" to force mock mode even if OPENAI_API_KEY is set (useful in CI)
MOCK_MODE=
